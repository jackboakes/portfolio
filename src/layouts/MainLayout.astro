---
import { Font } from "astro:assets";
import '../styles/global.css';
const { pageTitle } = Astro.props;
const { description } = Astro.props
---

<!--
|-----------------------------|
|            __ SILLY BILLY!  |
|           /  \   ~~|~~      |
|          (|00|)    |        |
