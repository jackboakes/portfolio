---
import  MainLayout  from "../layouts/MainLayout.astro";
const allPosts = Object.values(import.meta.glob('./blog/*.md', { eager: true }));
import { Image } from 'astro:assets';
const pageTitle = "Jack Boakes";
import runeShifterImage from '../assets/images/rune-shifter.png';
import cowImage from '../assets/images/cow.jpg';
import hammerHeadImage from '../assets/images/great-hammerhead.png';
import breakoutImage from '../assets/images/breakout.png';
import gameEngineImage from '../assets/images/magik-and-clay.png';
import rocksImage from '../assets/images/rocks.jpg';
import starsImage from '../assets/images/star_constellation.jpg';
---
<MainLayout pageTitle={pageTitle} description={"A developer portfolio by Jack Boakes"}>
    <main>
        <div class="lhs">
            <section class="info">
                        <header>
                            <h1><a href="/">Jack Boakes</a></h1>
                        </header>
                        <p>Hey, I'm Jack, a Computer Science graduate from Deakin University focused on gameplay programming and engine development. I enjoy building stuff from scratch and getting into the details.</p>
                        <p>In my spare time, I enjoy working on side projects — mostly games, reading books, and lately I've been programming my own engine in C++.</p>
                        <nav>
                            <ul class="links">
                                <li><a href="https://x.com/jackboakes_" target="_blank" rel="noopener noreferrer">X</a></li>
                                <li><a href="https://jackboakes.itch.io/" target="_blank" rel="noopener noreferrer">Itch.io</a></li>
                                <li><a href="https://www.linkedin.com/in/jack-boakes-/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                                <li><a href="https://github.com/jackboakes" target="_blank" rel="noopener noreferrer">Github</a></li>
                                <li><a href="mailto:hello@jackboakes.com">Email</a></li>
                            </ul>
                        </nav>
                        <nav>
                            <ul class="links">
                            {allPosts
                                .sort((a: any, b: any) => b.frontmatter.pubDate.localeCompare(a.frontmatter.pubDate))
                                .map((post: any) => (
                                <li>
                                    <a href={post.url}>{post.frontmatter.title}</a>
                                    <span class="post-date">
                                        {new Date(post.frontmatter.pubDate).toLocaleDateString("en-US", {
                                        weekday: "short",
                                        year: "numeric",
                                        month: "short",
                                        day: "numeric"
                                        }) + " "}
                                    </span>
                                </li>
                                ))}
                            </ul>
                        </nav>
                    </section>

                    <section class="gallery">

                        <div class="gallery-column">
                            <Image class="gallery-image" src={runeShifterImage} alt="2D dungeon puzzle gameplay screenshot" data-caption="(1) Rune Shifter, a 2D puzzle game"/>
                            <Image class="gallery-image" src={cowImage} alt="Bag with cow art" data-caption="(2) Photograph of a bag with a cow"/>
                        </div>
                        
                        
                        <div class="gallery-column">
                            <Image class="gallery-image" src={hammerHeadImage} alt="Lowpoly Great Hammerhead 3D model" data-caption="(3) 3D model of a Hammerhead Shark"/>
                            <Image class="gallery-image" src={breakoutImage} alt="Breakout gameplay screenshot" data-caption="(4) Breakout, a 2D game"/>
                            <Image class="gallery-image" src={gameEngineImage} alt="Magik and Clay gameplay screenshot" data-caption="(5) Magik and Clay, a 2D game engine"/>
                        </div>
                        
                        
                        <div class="gallery-column">
                            <Image class="gallery-image" src={rocksImage} alt="Coastal view with rocks" data-caption="(6) Photograph of Black Rock Beach, Cape Schanck"/>
                            <Image class="gallery-image" src={starsImage} alt="2D star constellation puzzle gameplay screenshot" data-caption="(7) 2D puzzle game made for my university capstone"/>
                        </div>
                    </section>
        </div>

        <div class="rhs">

        </div>
        
    </main>
    <script>
        import "../scripts/imgpreview.js";
    </script>
</MainLayout>


<style>
    main {
        display: flex;
        padding: 1.6rem;
    }

    .lhs {
        display: grid;
        grid-template-columns: 1fr;
        
    }

    .rhs {
        display: none;
    }

    h1 {
        font-size: var(--title-font-size);
        margin-bottom: 5rem;
    }

    h1 a {
        text-decoration: none;
    }

    .info {
        margin-bottom: 10rem;
    }

    .info p {
        line-height: 1.8;
    }

    .links {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 2.5rem;
        margin-top: 10rem;
    }

    .links li {
        display: flex;
        justify-content: space-between;
        list-style: none;
        padding: 0;
    }

    .links li .post-date {
        opacity: 0.5;
    }

    .gallery {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--gap-size);
    }

    .gallery-column {
        display: flex;
        flex-direction: column;
        gap: var(--gap-size);
    }

    .gallery-image {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (width >= 768px) {
        .lhs {
            max-width: 65ch;
        }
        
        .gallery {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (width >= 1024px) {
        .lhs {
            flex: 0 0 65ch;
        }

        .rhs {
            display: block;
            flex: 1;
            position: sticky;
            top: 1.6rem;
            height: calc(100vh - 3.2rem);
        }
    }
</style>
